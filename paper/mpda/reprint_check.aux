\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Derived measures against a published asymptomatic reference ($n=260$, standing)~\cite  {vialle2005}. This cohort is supine, and the two postural measures depart in opposite directions --- sacral slope 4.1\si {\degree } lower, pelvic tilt 4.3\si {\degree } higher. That is one discrepancy, not two: $PI = PT + SS$ holds by construction, so with pelvic incidence at its published value any fall in one appears as an equal rise in the other.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:spinopelvic}{{II}{8}{Derived measures against a published asymptomatic reference ($n=260$, standing)~\cite {vialle2005}. This cohort is supine, and the two postural measures depart in opposite directions --- sacral slope 4.1\si {\degree } lower, pelvic tilt 4.3\si {\degree } higher. That is one discrepancy, not two: $PI = PT + SS$ holds by construction, so with pelvic incidence at its published value any fall in one appears as an equal rise in the other}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Surgical instrumentation. (a) An unreviewed metal threshold over-counts instrumentation sevenfold. (b) Saturation cannot sort implant from artefact: both reach the scanner ceiling and several artefacts exceed it. (c) Site and volume can. (d) Every confirmed implant was already labelled as bone, so naming it reclaims voxels from the structure that held them.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:hardware}{{4}{8}{Surgical instrumentation. (a) An unreviewed metal threshold over-counts instrumentation sevenfold. (b) Saturation cannot sort implant from artefact: both reach the scanner ceiling and several artefacts exceed it. (c) Site and volume can. (d) Every confirmed implant was already labelled as bone, so naming it reclaims voxels from the structure that held them}{figure.4}{}}
