\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Spinopelvic measures against published reference bands (mean $\pm $ SD) from an asymptomatic standing cohort.\cite  {vialle2005} Sacral slope is expected to sit below a standing reference because it is postural and this cohort is supine; pelvic incidence is not postural, which is why it can be compared without apology and why its agreement is the strongest check here.}}{17}{figure.4}\protected@file@percent }
\newlabel{fig:validation}{{4}{17}{Spinopelvic measures against published reference bands (mean $\pm $ SD) from an asymptomatic standing cohort.\cite {vialle2005} Sacral slope is expected to sit below a standing reference because it is postural and this cohort is supine; pelvic incidence is not postural, which is why it can be compared without apology and why its agreement is the strongest check here}{figure.4}{}}
