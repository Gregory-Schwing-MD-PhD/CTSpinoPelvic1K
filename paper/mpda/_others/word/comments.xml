:t xml:space="preserve">define. and other acronyms used </w:t></w:r></w:p></w:comment><w:comment w:initials="JK" w:author="Jerick Kim" w:date="2026-09-07T19:19:55" w:id="822605769" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:p w:rsidR="5DC27A37" w:rsidRDefault="2790D689" w14:paraId="18A0936D" w14:textId="7A3E0DFC" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="4557472C" w:rsidR="7F0674F6"><w:t>there are limitations mentioned multiple times throughout the manuscript. not sure if you want to consolidate into one at the end or keep as is</w:t></w:r></w:p></w:comment><w:comment w:initials="MK" w:author="Maggie Khoushi" w:date="2026-09-08T22:21:03" w:id="448181744" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:p w:rsidR="1A5D3859" w:rsidRDefault="6456C4DE" w14:paraId="22558AB7" w14:textId="273EB0ED" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="0F661842" w:rsidR="54921DFB"><w:t>^^^</w:t></w:r></w:p></w:comment><w:comment w:initials="JK" w:author="Jerick Kim" w:date="2026-09-07T19:27:19" w:id="594351037" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:p w:rsidR="5F4D57F2" w:rsidRDefault="7324A019" w14:paraId="47871DA9" w14:textId="689DC41A" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="41D4F151" w:r